{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anam AI Avatars Share Links API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Share Links",
        "type": "folder"
      },
      "items": [
